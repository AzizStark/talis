#!/usr/bin/make -f
export CARGO_TARGET_DIR ?= $(CURDIR)/target/packages
export PATH := /usr/lib/rust-1.85/bin:$(PATH)

%:
	dh $@

override_dh_auto_configure:
	bash debian/build.sh configure "$(CARGO_TARGET_DIR)"

override_dh_auto_build:
	bash debian/build.sh build "$(CARGO_TARGET_DIR)"

override_dh_auto_test:
	bash debian/build.sh test "$(CARGO_TARGET_DIR)"

override_dh_auto_install:
	bash debian/build.sh install "$(CARGO_TARGET_DIR)"

# The bundled library is private, not a system-wide provider of its SONAME.
override_dh_makeshlibs:
	dh_makeshlibs -Xlibgtk4-layer-shell.so

override_dh_shlibdeps:
	dh_shlibdeps -l"$(CURDIR)/debian/talis/usr/lib/talis"

# Cargo's release profile does not emit DWARF debug information.
override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym
